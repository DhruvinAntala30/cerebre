<style is:inline>
  .problem_faq-ans {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.5s ease,
      opacity 0.35s ease;
  }

  .problem_faq-ans > * {
    min-height: 0;
    overflow: hidden;
  }

  .problem_faq-item.active .problem_faq-ans {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .problem_faq-ans .problem_image-bg {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .problem_faq-item.active .problem_faq-ans .problem_image-bg {
    opacity: 1;
  }

  .problem_faq-item.active {
    flex: 1 1 auto;
    border-color: var(--_colors---colors--golden);
  }

  .problem_faq-que.active .text-color-charcoal,
  .problem_faq-que.active .problem_icon {
    color: var(--_colors---colors--black);
  }

  .problem_faq-que.active .tag-large.text-color-charcoal {
    color: var(--_colors---colors--golden);
  }

  .problem_content-wrap p {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }

  .problem_faq-item.active .problem_content-wrap p {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.12s;
  }
</style>
