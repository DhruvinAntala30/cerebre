<Fragment slot="footer"><script is:inline>
  // Tab Animation
  (function onReady(callback, options) {
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", callback, options);
  } else if (!options?.signal?.aborted) {
    const event = new Event("DOMContentLoaded");
    if (typeof callback === "function") callback.call(document, event);
    else callback?.handleEvent(event);
  }
})( function () {
    document.querySelectorAll('[tab-block]').forEach(function (block) {
      const questions = block.querySelectorAll('[que]');
      const images = document.querySelectorAll('[img]');

      function setActive(question) {
        const value = question.getAttribute('que');

        questions.forEach(function (item) {
          item.classList.remove('active');
          item.closest('.problem_faq-item')?.classList.remove('active');
        });

        images.forEach(function (img) {
          img.classList.remove('active');
        });

        question.classList.add('active');
        question.closest('.problem_faq-item')?.classList.add('active');

        document.querySelectorAll('[img="' + value + '"]').forEach(function (img) {
          img.classList.add('active');
        });
      }

      questions.forEach(function (question) {
        question.addEventListener('click', function () {
          setActive(question);
        });
      });

      const defaultQuestion = block.querySelector('[que="1"]');

      if (defaultQuestion) {
        setActive(defaultQuestion);
      }
    });
  });
</script>

<script is:inline>
  // TOC Link Progress + Keep Active Link in View
  (function onReady(callback, options) {
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", callback, options);
  } else if (!options?.signal?.aborted) {
    const event = new Event("DOMContentLoaded");
    if (typeof callback === "function") callback.call(document, event);
    else callback?.handleEvent(event);
  }
})( function () {
    const tocBlock = document.querySelector('.toc_links-block');
    if (!tocBlock) return;

    const tocLinks = Array.from(tocBlock.querySelectorAll('.toc_links-wrap'));

    const items = tocLinks
      .map((link) => ({
        link,
        progress: link.querySelector('.toc_progress'),
        section: document.querySelector(link.getAttribute('href')),
      }))
      .filter((item) => item.section);

    if (!items.length) return;

    let lastActiveIndex = -1;

    function keepActiveInView(activeLink) {
      const blockRect = tocBlock.getBoundingClientRect();
      const linkRect = activeLink.getBoundingClientRect();

      if (linkRect.left < blockRect.left) {
        tocBlock.scrollTo({
          left: tocBlock.scrollLeft - (blockRect.left - linkRect.left) - 16,
          behavior: 'smooth',
        });
      } else if (linkRect.right > blockRect.right) {
        tocBlock.scrollTo({
          left: tocBlock.scrollLeft + (linkRect.right - blockRect.right) + 16,
          behavior: 'smooth',
        });
      }
    }

    function updateProgress(forceScroll = false) {
      const trigger = window.innerHeight * 0.5;
      let activeIndex = 0;

      items.forEach((item, index) => {
        if (item.section.getBoundingClientRect().top <= trigger) {
          activeIndex = index;
        }
      });

      items.forEach((item, index) => {
        const isActive = index === activeIndex;

        item.link.classList.toggle('w--current', isActive);
        item.link.classList.toggle('active', isActive);

        if (!item.progress) return;

        if (!isActive) {
          item.progress.style.width = '0%';
          return;
        }

        const rect = item.section.getBoundingClientRect();
        const height = item.section.offsetHeight;

        const percentage = Math.max(0, Math.min(100, ((trigger - rect.top) / height) * 100));

        item.progress.style.width = percentage + '%';
      });

      // Scroll only when the active link changes or on resize
      if (activeIndex !== lastActiveIndex || forceScroll) {
        keepActiveInView(items[activeIndex].link);
        lastActiveIndex = activeIndex;
      }
    }

    window.addEventListener('scroll', () => updateProgress(), { passive: true });
    window.addEventListener('resize', () => updateProgress(true));

    updateProgress();
  });
</script></Fragment>
