<script is:inline>
  // Tab Animation
  (function onReady(callback, options) {
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", callback, options);
  } else if (!options?.signal?.aborted) {
    const event = new Event("DOMContentLoaded");
    if (typeof callback === "function") callback.call(document, event);
    else callback?.handleEvent(event);
  }
})( function () {
    document.querySelectorAll('[tab-block]').forEach(function (block) {
      const questions = block.querySelectorAll('[que]');
      const images = document.querySelectorAll('[img]');

      function setActive(question) {
        const value = question.getAttribute('que');

        questions.forEach(function (item) {
          item.classList.remove('active');
          item.closest('.problem_faq-item')?.classList.remove('active');
        });

        images.forEach(function (img) {
          img.classList.remove('active');
        });

        question.classList.add('active');
        question.closest('.problem_faq-item')?.classList.add('active');

        document.querySelectorAll('[img="' + value + '"]').forEach(function (img) {
          img.classList.add('active');
        });
      }

      questions.forEach(function (question) {
        question.addEventListener('click', function () {
          setActive(question);
        });
      });

      const defaultQuestion = block.querySelector('[que="1"]');

      if (defaultQuestion) {
        setActive(defaultQuestion);
      }
    });
  });
</script>

