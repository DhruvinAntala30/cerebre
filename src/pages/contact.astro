<script is:inline>
  // Contact page dropdown behavior (standalone Astro build)
  document.addEventListener('DOMContentLoaded', function () {
    const dropdowns = Array.from(document.querySelectorAll('.select_dd'));

    function setDropdownState(dropdown, open) {
      const toggle = dropdown.querySelector('.w-dropdown-toggle');
      const list = dropdown.querySelector('.w-dropdown-list');
      if (!toggle || !list) return;

      dropdown.classList.toggle('w--open', open);
      toggle.classList.toggle('w--open', open);
      list.classList.toggle('w--open', open);
      toggle.setAttribute('aria-expanded', String(open));

      // Match Webflow's stacking behavior while a dropdown is open.
      if (open) {
        dropdown.style.zIndex = '901';
      } else {
        dropdown.style.removeProperty('z-index');
      }
    }

    dropdowns.forEach((dropdown) => {
      const toggle = dropdown.querySelector('.w-dropdown-toggle');
      if (!toggle) return;

      toggle.setAttribute('aria-haspopup', 'menu');
      toggle.setAttribute('aria-expanded', 'false');

      toggle.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();

        const shouldOpen = !dropdown.classList.contains('w--open');
        dropdowns.forEach((item) => setDropdownState(item, false));
        if (shouldOpen) setDropdownState(dropdown, true);
      });
    });

    document.addEventListener('click', function (event) {
      const option = event.target.closest('[data-select="option"]');
      if (option) {
        const parent = option.closest('.select_dd');
        if (parent) setDropdownState(parent, false);
        return;
      }

      if (!event.target.closest('.select_dd')) {
        dropdowns.forEach((dropdown) => setDropdownState(dropdown, false));
      }
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') {
        dropdowns.forEach((dropdown) => setDropdownState(dropdown, false));
      }
    });

    // Webflow's custom checkbox UI mirrors the native input's checked state.
    function syncCustomCheckbox(input) {
      const checkbox = input.parentElement?.querySelector('.w-checkbox-input');
      if (checkbox) {
        checkbox.classList.toggle('w--redirected-checked', input.checked);
        checkbox.classList.toggle('w--redirected-focus', input === document.activeElement);
      }
    }

    document.querySelectorAll('.w-checkbox input[type="checkbox"]').forEach((input) => {
      syncCustomCheckbox(input);
      input.addEventListener('change', () => syncCustomCheckbox(input));
      input.addEventListener('focus', () => syncCustomCheckbox(input));
      input.addEventListener('blur', () => syncCustomCheckbox(input));
    });
  });
</script>

<script is:inline>
  // Custom Select Dropdown
  $(document).ready(function () {
    $('[data-select="option"]').on('click', function (e) {
      e.preventDefault();

      const $wrap = $(this).closest('[data-select="wrapper"]');
      const $toggle = $wrap.find('[data-select="toggle"]');
      const value = $(this).text().trim();

      $wrap.find('[data-select="label"]').text(value);
      $wrap.find('[data-select="input"]').val(value);

      // Active state
      $wrap.find('[data-select="option"]').removeClass('active');
      $(this).addClass('active');
      $toggle.addClass('active');

      // Close dropdown
      $toggle.trigger('w-close');
    });
  });
</script>
<script is:inline>
  (function onReady(callback, options) {
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", callback, options);
  } else if (!options?.signal?.aborted) {
    const event = new Event("DOMContentLoaded");
    if (typeof callback === "function") callback.call(document, event);
    else callback?.handleEvent(event);
  }
})( function () {
    document.querySelectorAll('[dd-multi]').forEach((dropdown) => {
      const toggleText = dropdown.querySelector('[dd-multi-toggle]');
      const checkboxes = dropdown.querySelectorAll("[dd-multi-wrap] input[type='checkbox']");

      if (!toggleText || !checkboxes.length) return;

      const defaultText = 'Select one or multiple';

      function updateToggleText() {
        const selectedCount = Array.from(checkboxes).filter((checkbox) => checkbox.checked).length;

        toggleText.textContent = selectedCount > 0 ? `${selectedCount} selected` : defaultText;
      }

      checkboxes.forEach((checkbox) => {
        checkbox.addEventListener('change', updateToggleText);
      });

      updateToggleText();
    });
  });
</script>
<script is:inline>
