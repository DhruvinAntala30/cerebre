---
import __lumosAsset48 from '@/assets/jquery-3.5.1.min.dc5e7f18c8.js?url';
import __lumosAsset49 from '@/assets/webflow.schunk.36b8fb49256177c8.js?url';
import __lumosAsset50 from '@/assets/webflow.schunk.d96dd457d4ae03c1.js?url';
import __lumosAsset51 from '@/assets/webflow.1b2c5186.e9a05dc5525d0d39.js?url';

const { pageTitle = '', pageDescription = '', webflowPageId, ...rest } = Astro.props;
---
<!doctype html>
<html lang="en" data-wf-site="6ad87f6e0a8188c740d5afe1" data-wf-page={webflowPageId}>
<head>
<meta charset="utf-8" />
<script is:inline>document.documentElement.classList.add("w-mod-js"); if ("ontouchstart" in window) document.documentElement.classList.add("w-mod-touch");</script>
<link rel="stylesheet" href="/css/normalize.css" />
<link rel="stylesheet" href="/css/webflow.css" />
<link rel="stylesheet" href="/css/cerebre.webflow.css" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<style is:inline>
  /* for font smoothing */
  body {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  /* Button Hover Animation */
  @media (min-width: 992px) {
    .button:hover .btn_icon-wrap.is-left {
      margin-right: 0.25rem;
    }
    .button:hover .btn_icon-wrap.is-right {
      margin-left: 0;
    }
  }
</style>
<slot name="head" />
</head>
<body {...rest}>
<slot />
<script is:inline src={__lumosAsset48} type="text/javascript"></script>
<script is:inline src={__lumosAsset49} type="text/javascript"></script>
<script is:inline src={__lumosAsset50} type="text/javascript"></script>
<script is:inline src={__lumosAsset51} type="text/javascript"></script>

<slot name="footer" />
</body>
</html>
